{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gbagent JSON-RPC API",
  "description": "JSON-RPC 2.0 methods for gbagent Game Boy emulator",
  "transport": ["stdio", "websocket"],
  "methods": {
    "screenshot": {
      "description": "Get the current screen as a base64-encoded PNG",
      "params": {},
      "result": {
        "type": "string",
        "description": "Base64-encoded PNG image (160×144)",
        "contentMediaType": "image/png"
      }
    },
    "step_frames": {
      "description": "Advance N frames with optional buttons held, return final screenshot",
      "params": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of frames to advance"
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["A","B","START","SELECT","UP","DOWN","LEFT","RIGHT"]
          },
          "description": "Buttons to hold while advancing (released after). Pressed sequentially — simultaneous press not supported."
        }
      },
      "result": {
        "type": "string",
        "description": "Base64-encoded PNG of the final frame"
      }
    },
    "press_button": {
      "description": "Press a button (latches until release_button or next operation)",
      "params": {
        "button": {
          "type": "string",
          "enum": ["A","B","START","SELECT","UP","DOWN","LEFT","RIGHT"]
        }
      },
      "result": {}
    },
    "release_button": {
      "description": "Release a previously pressed button",
      "params": {
        "button": {
          "type": "string",
          "enum": ["A","B","START","SELECT","UP","DOWN","LEFT","RIGHT"]
        }
      },
      "result": {}
    },
    "release_all": {
      "description": "Release all currently pressed buttons",
      "params": {},
      "result": {}
    },
    "read_ram": {
      "description": "Read a byte from Game Boy memory",
      "params": {
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Memory address (0x0000-0xFFFF)"
        }
      },
      "result": {
        "type": "integer",
        "description": "Byte value at the address (0x00-0xFF)"
      }
    },
    "read_ram_range": {
      "description": "Read a range of RAM bytes",
      "params": {
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "result": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "description": "Array of byte values"
      }
    },
    "write_ram": {
      "description": "Write a byte to Game Boy memory",
      "params": {
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "result": {}
    },
    "get_state": {
      "description": "Get full emulator state snapshot (advances 1 frame)",
      "params": {},
      "result": {
        "type": "object",
        "description": "Emulator state (CPU, PPU, timer, APU, cartridge info)"
      }
    },
    "save_state": {
      "description": "Save emulator state to a file",
      "params": {
        "path": {
          "type": "string",
          "description": "File path to save the state"
        }
      },
      "result": {}
    },
    "load_state": {
      "description": "Load emulator state from a file",
      "params": {
        "path": {
          "type": "string",
          "description": "File path to load the state from"
        }
      },
      "result": {}
    },
    "reset": {
      "description": "Reset the emulator (soft reset)",
      "params": {},
      "result": {}
    }
  }
}
